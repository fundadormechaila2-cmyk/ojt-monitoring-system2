rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn() && profile().data.role == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isCoordinator() {
      return hasRole("coordinator");
    }

    function isStaff() {
      return hasRole("staff");
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isCoordinator() || (signedIn() && request.auth.uid == studentId);
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isCoordinator() || isStaff();
      allow create, update, delete: if isAdmin() || isStaff();
    }

    match /applications/{applicationId} {
      allow read: if isAdmin() || isCoordinator() || isStaff();
      allow create: if isAdmin() || isStaff();
      allow update: if isAdmin() || isCoordinator() || isStaff();
      allow delete: if isAdmin();
    }

    match /evaluations/{evaluationId} {
      allow read: if isAdmin() || isCoordinator() || isStaff();
      allow create, update: if isAdmin() || isCoordinator() || isStaff();
      allow delete: if isAdmin();
    }

    match /partnerCompanies/{companyId} {
      allow read: if isAdmin() || isCoordinator() || isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
