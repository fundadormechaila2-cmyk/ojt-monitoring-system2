rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // AUTHENTICATION AND ROLE HELPERS

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn() && profile().data.role == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isCoordinator() {
      return hasRole("coordinator");
    }

    function isStaff() {
      return hasRole("staff");
    }

    function ownsAccount(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // DEPARTMENT HELPERS

    function departmentCode(value) {
      return !(value is string) ? "" :
        value.matches("(?i).*\\bbsba\\b.*") || value.matches("(?i).*business administration.*") ? "BSBA" :
        value.matches("(?i).*\\bbsit\\b.*") || value.matches("(?i).*information technology.*") ? "BSIT" :
        value.matches("(?i).*\\bbshm\\b.*") || value.matches("(?i).*hospitality management.*") ? "BSHM" :
        value.matches("(?i).*\\bbsed\\b.*") || value.matches("(?i).*secondary education.*") ? "BSED" :
        value.matches("(?i).*\\bbeed\\b.*") || value.matches("(?i).*elementary education.*") ? "BEED" : "";
    }

    function coordinatorDepartment() {
      let id = departmentCode(profile().data.get("departmentId", ""));
      return id != "" ? id : departmentCode(profile().data.get("department", ""));
    }

    // COORDINATOR SUPERVISOR ACCOUNT CREATION

    function coordinatorCreatesSupervisor() {
      return isCoordinator() &&
        request.resource.data.get("role", "") == "supervisor" &&
        request.resource.data.get("createdBy", "") == request.auth.uid &&
        departmentCode(
          request.resource.data.get(
            "departmentId",
            request.resource.data.get("department", "")
          )
        ) == coordinatorDepartment();
    }

    // VALIDATE SUPERVISOR ASSIGNMENT

    function validCoordinatorSupervisorAssignment() {
      let supervisorUid = request.resource.data.get("supervisorUid", "");

      return supervisorUid == "" || supervisorUid == null ||
        (
          supervisorUid is string &&
          existsAfter(/databases/$(database)/documents/users/$(supervisorUid)) &&
          getAfter(/databases/$(database)/documents/users/$(supervisorUid)).data.get("role", "") == "supervisor" &&
          getAfter(/databases/$(database)/documents/users/$(supervisorUid)).data.get("createdBy", "") == request.auth.uid &&
          departmentCode(
            getAfter(/databases/$(database)/documents/users/$(supervisorUid)).data.get(
              "departmentId",
              getAfter(/databases/$(database)/documents/users/$(supervisorUid)).data.get("department", "")
            )
          ) == coordinatorDepartment()
        );
    }

    // USERS COLLECTION

    match /users/{userId} {

  allow update: if isAdmin() || (
  isCoordinator() &&
  resource.data.get("role", "") == "supervisor" &&
  resource.data.get("createdBy", "") == request.auth.uid &&
  request.resource.data.get("role", "") == "supervisor" &&
  request.resource.data.get("createdBy", "") == request.auth.uid &&
  request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly([
      "firstName",
      "lastName",
      "phone",
      "position",
      "company",
      "schoolYear",
      "partnerCompanyId",
      "updatedAt"
    ]) &&
  request.resource.data.updatedAt == request.time
) || (
  signedIn() &&
  request.auth.uid == userId &&
  (isCoordinator() || hasRole("supervisor")) &&
  request.resource.data.diff(resource.data).affectedKeys()
    .hasOnly(["firstName", "lastName", "contactNumber", "updatedAt"]) &&
  request.resource.data.firstName is string &&
  request.resource.data.lastName is string &&
  request.resource.data.contactNumber is string &&
  request.resource.data.updatedAt == request.time
);

    }

    // COORDINATOR ACCOUNTS

    match /coordinatorsAccount/{uid} {

      allow read: if isAdmin() || ownsAccount(uid);

      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        ownsAccount(uid) &&
        hasRole("coordinator") &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["firstName", "lastName", "contactNumber", "updatedAt"])
      );
    }

    // SUPERVISOR ACCOUNTS

    match /supervisorsAccount/{uid} {

      allow read: if isAdmin() || ownsAccount(uid) || isCoordinator();

      allow create: if isAdmin() || coordinatorCreatesSupervisor();

      allow update: if isAdmin() ||
        (isCoordinator() &&
          resource.data.get("createdBy", "") == request.auth.uid) ||
        (
          ownsAccount(uid) &&
          hasRole("supervisor") &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["firstName", "lastName", "contactNumber", "updatedAt"])
        );

      allow delete: if isAdmin();
    }

    // STUDENT ACCOUNTS

    match /studentsAccount/{uid} {

      allow read: if isAdmin() ||
        ownsAccount(uid) ||
        (isCoordinator() &&
          resource.data.get("coordinatorUid", "") == request.auth.uid) ||
        (hasRole("supervisor") &&
          resource.data.get("supervisorUid", "") == request.auth.uid);

      allow create, delete: if isAdmin();

      allow update: if isAdmin() ||
        (
          isCoordinator() &&
          resource.data.get("coordinatorUid", "") == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "supervisorUid",
              "supervisorName",
              "supervisorSchoolYear",
              "updatedAt"
            ])
        ) ||
        (
          ownsAccount(uid) &&
          hasRole("student") &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "email",
              "phone",
              "contactNumber",
              "address",
              "updatedAt"
            ])
        );
    }

    // SCHOOL YEARS

    match /schoolYears/{yearId} {
      allow read: if isAdmin() || isCoordinator();
    }

    // STUDENT ROSTER

    match /students/{studentId} {

      allow read: if isAdmin() ||
        (
          isCoordinator() &&
          coordinatorDepartment() != "" &&
          resource.data.get("departmentId", "") == coordinatorDepartment() &&
          resource.data.get("coordinatorUid", "") == request.auth.uid
        ) ||
        (hasRole("student") && request.auth.uid == studentId) ||
        (hasRole("student") &&
          resource.data.studentUid == request.auth.uid);

      allow create, delete: if isAdmin();

      allow update: if isAdmin() ||
        (
          isCoordinator() &&
          resource.data.get("coordinatorUid", "") == request.auth.uid &&
          resource.data.get("departmentId", "") == coordinatorDepartment() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "supervisorUid",
              "supervisorName",
              "supervisorSchoolYear",
              "partnerCompanyId",
              "company",
              "updatedAt"
            ]) &&
          validCoordinatorSupervisorAssignment()
        );
    }

    // ATTENDANCE

    match /attendance/{attendanceId} {

      allow read: if isAdmin() || isStaff() ||
        (
          isCoordinator() &&
          coordinatorDepartment() != "" &&
          resource.data.get("studentUid", "") != "" &&
          exists(/databases/$(database)/documents/users/$(resource.data.studentUid)) &&
          get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.get("coordinatorUid", "") == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.get("departmentId", "") == coordinatorDepartment() &&
          get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.get("studentRecordId", "") != "" &&
          exists(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)) &&
          get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)).data.get("coordinatorUid", "") == request.auth.uid &&
          get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)).data.get("departmentId", "") == coordinatorDepartment() &&
          get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)).data.get("studentUid", "") == resource.data.studentUid
        ) ||
        (hasRole("student") &&
          resource.data.studentUid == request.auth.uid);

      allow create, update, delete: if isAdmin() || isStaff();
    }

    // APPLICATIONS

    match /applications/{applicationId} {

      allow read: if isAdmin() || isCoordinator() || isStaff();

      allow create: if isAdmin() || isStaff();

      allow update: if isAdmin() || isCoordinator() || isStaff();

      allow delete: if isAdmin();
    }

    // EVALUATIONS

    match /evaluations/{evaluationId} {

      allow read: if isAdmin() || isCoordinator() || isStaff();

      allow create, update: if isAdmin() || isCoordinator() || isStaff();

      allow delete: if isAdmin();
    }

    // PARTNER COMPANIES

    match /partnerCompanies/{companyId} {

      allow read: if isAdmin() || isCoordinator() || isStaff();

      allow create, update, delete: if isAdmin();
    }

    // DEFAULT DENY

    match /{document=**} {
      allow read, write: if false;
    }
  }
}