rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn() && profile().data.role == role &&
        profile().data.get("mustChangePassword", false) != true;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isCoordinator() {
      return hasRole("coordinator");
    }

    function isStaff() {
      return hasRole("staff");
    }

    function ownsAccount(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function departmentCode(value) {
      return !(value is string) ? "" :
        value.matches("(?i).*\\bbsba\\b.*") || value.matches("(?i).*business administration.*") ? "BSBA" :
        value.matches("(?i).*\\bbsit\\b.*") || value.matches("(?i).*information technology.*") ? "BSIT" :
        value.matches("(?i).*\\bbshm\\b.*") || value.matches("(?i).*hospitality management.*") ? "BSHM" :
        value.matches("(?i).*\\bbsed\\b.*") || value.matches("(?i).*secondary education.*") ? "BSED" :
        value.matches("(?i).*\\bbeed\\b.*") || value.matches("(?i).*elementary education.*") ? "BEED" : "";
    }

    function coordinatorDepartment() {
      let id = departmentCode(profile().data.get("departmentId", ""));
      return id != "" ? id : departmentCode(profile().data.get("department", ""));
    }

    function validCoordinatorSupervisorAssignment() {
      let supervisorUid = request.resource.data.get("supervisorUid", "");

      return supervisorUid == "" || supervisorUid == null ||
        (
          supervisorUid is string &&
          existsAfter(/databases/$(database)/documents/users/$(supervisorUid)) &&
          getAfter(/databases/$(database)/documents/users/$(supervisorUid)).data.get("role", "") == "supervisor" &&
          getAfter(/databases/$(database)/documents/users/$(supervisorUid)).data.get("createdBy", "") == request.auth.uid &&
          departmentCode(
            getAfter(/databases/$(database)/documents/users/$(supervisorUid)).data.get(
              "departmentId",
              getAfter(/databases/$(database)/documents/users/$(supervisorUid)).data.get("department", "")
            )
          ) == coordinatorDepartment()
        );
    }

    function validNewSupervisor(userId) {
      let data = request.resource.data;
      return isCoordinator() && coordinatorDepartment() != "" &&
        data.keys().hasOnly([
          "uid", "email", "firstName", "lastName", "role", "phone", "position",
          "department", "departmentId", "coordinatorUid", "createdBy", "company",
          "partnerCompanyId", "schoolYear", "assignedStudentRecordId", "status",
          "isActive", "isArchived", "mustChangePassword", "accountNotificationStatus",
          "accountNotificationUpdatedAt", "createdAt", "updatedAt"
        ]) &&
        data.uid == userId && data.role == "supervisor" &&
        data.createdBy == request.auth.uid && data.coordinatorUid == request.auth.uid &&
        data.department == profile().data.department &&
        data.departmentId == coordinatorDepartment() &&
        data.email is string && data.email.matches("^[^\\s@]+@gmail\\.com$") &&
        data.firstName is string && data.firstName.size() > 0 &&
        data.lastName is string && data.lastName.size() > 0 &&
        data.company is string && data.company.size() > 0 &&
        data.schoolYear is string && data.schoolYear.size() > 0 &&
        data.assignedStudentRecordId is string &&
        data.status == "ACTIVE" && data.isActive == true && data.isArchived == false &&
        data.mustChangePassword == false && data.accountNotificationStatus == "Pending" &&
        data.createdAt == request.time && data.updatedAt == request.time &&
        data.accountNotificationUpdatedAt == request.time;
    }

    function supervisorSetupStatusUpdate() {
      return isCoordinator() &&
        resource.data.get("role", "") == "supervisor" &&
        resource.data.get("createdBy", "") == request.auth.uid &&
        resource.data.get("departmentId", "") == coordinatorDepartment() &&
        resource.data.get("mustChangePassword", true) == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "accountNotificationStatus", "accountNotificationUpdatedAt", "updatedAt"
        ]) &&
        request.resource.data.accountNotificationStatus in ["Pending", "Sent", "Failed"] &&
        request.resource.data.accountNotificationUpdatedAt == request.time &&
        request.resource.data.updatedAt == request.time;
    }

    match /users/{userId} {

      allow read: if isAdmin() ||
        (signedIn() && request.auth.uid == userId) ||
        (isCoordinator() &&
          resource.data.get("role", "") == "student" &&
          resource.data.get("coordinatorUid", "") == request.auth.uid) ||
        (isCoordinator() &&
          resource.data.role == "supervisor" &&
          resource.data.department == profile().data.department);

      allow create: if isAdmin() || validNewSupervisor(userId);

      allow delete: if isAdmin();

      allow update: if isAdmin() || supervisorSetupStatusUpdate() || (
        isCoordinator() &&
        resource.data.get("role", "") == "student" &&
        resource.data.get("coordinatorUid", "") == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["supervisorUid", "supervisorName", "supervisorSchoolYear", "updatedAt"]) &&
        validCoordinatorSupervisorAssignment()
      ) || (
        isCoordinator() &&
        resource.data.get("role", "") == "supervisor" &&
        resource.data.get("createdBy", "") == request.auth.uid &&
        request.resource.data.get("role", "") == "supervisor" &&
        request.resource.data.get("createdBy", "") == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "firstName",
            "lastName",
            "phone",
            "position",
            "company",
            "schoolYear",
            "partnerCompanyId",
            "updatedAt"
          ]) &&
        request.resource.data.updatedAt == request.time
      ) || (
        signedIn() &&
        request.auth.uid == userId &&
        (isCoordinator() || hasRole("supervisor")) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["firstName", "lastName", "contactNumber", "updatedAt"]) &&
        request.resource.data.firstName is string &&
        request.resource.data.lastName is string &&
        request.resource.data.contactNumber is string &&
        request.resource.data.updatedAt == request.time
      );
    }

    match /coordinatorsAccount/{uid} {
      allow read: if isAdmin() || ownsAccount(uid);

      allow create, delete: if isAdmin();

      allow update: if isAdmin() || (
        ownsAccount(uid) &&
        hasRole("coordinator") &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["firstName", "lastName", "contactNumber", "updatedAt"])
      );
    }

    match /supervisorsAccount/{uid} {
      allow read: if isAdmin() || ownsAccount(uid) || isCoordinator();

      allow create: if isAdmin() || (
        isCoordinator() &&
        request.resource.data == getAfter(/databases/$(database)/documents/users/$(uid)).data &&
        getAfter(/databases/$(database)/documents/users/$(uid)).data.createdBy == request.auth.uid
      );

      allow update: if isAdmin() ||
        (
          isCoordinator() &&
          resource.data.get("createdBy", "") == request.auth.uid
        ) || (
          ownsAccount(uid) &&
          hasRole("supervisor") &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["firstName", "lastName", "contactNumber", "updatedAt"])
        );

      allow delete: if isAdmin();
    }

    match /supervisors/{uid} {
      allow create: if isCoordinator() &&
        request.resource.data == getAfter(/databases/$(database)/documents/users/$(uid)).data &&
        getAfter(/databases/$(database)/documents/users/$(uid)).data.createdBy == request.auth.uid;
      allow update: if supervisorSetupStatusUpdate();
      allow read: if isAdmin() || (isCoordinator() && resource.data.get("createdBy", "") == request.auth.uid) || ownsAccount(uid);
    }

    match /studentsAccount/{uid} {
      allow read: if isAdmin() || ownsAccount(uid) ||
        (isCoordinator() && resource.data.get("coordinatorUid", "") == request.auth.uid) ||
        (isCoordinator() &&
          exists(/databases/$(database)/documents/users/$(uid)) &&
          get(/databases/$(database)/documents/users/$(uid)).data.get("role", "") == "student" &&
          get(/databases/$(database)/documents/users/$(uid)).data.get("coordinatorUid", "") == request.auth.uid) ||
        (hasRole("supervisor") && resource.data.get("supervisorUid", "") == request.auth.uid);

      allow create, delete: if isAdmin();

      allow update: if isAdmin() ||
        (
          isCoordinator() &&
          resource.data.get("coordinatorUid", "") == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["supervisorUid", "supervisorName", "supervisorSchoolYear", "updatedAt"])
        ) || (
          ownsAccount(uid) &&
          hasRole("student") &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["email", "phone", "contactNumber", "address", "updatedAt"])
        );
    }

    match /schoolYears/{yearId} {
      allow read: if isAdmin() || isCoordinator();
    }

    match /students/{studentId} {
      allow read: if isAdmin() ||
        (
          isCoordinator() &&
          coordinatorDepartment() != "" &&
          resource.data.get("departmentId", "") == coordinatorDepartment() &&
          resource.data.get("coordinatorUid", "") == request.auth.uid
        ) ||
        (hasRole("student") && request.auth.uid == studentId) ||
        (hasRole("student") && resource.data.studentUid == request.auth.uid);

      allow create, delete: if isAdmin();

      allow update: if isAdmin() ||
        (
          isCoordinator() &&
          resource.data.get("coordinatorUid", "") == request.auth.uid &&
          resource.data.get("departmentId", "") == coordinatorDepartment() &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              "supervisorUid",
              "supervisorName",
              "supervisorSchoolYear",
              "partnerCompanyId",
              "company",
              "updatedAt"
            ]) &&
          validCoordinatorSupervisorAssignment()
        );
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isStaff() ||
        (
          isCoordinator() &&
          coordinatorDepartment() != "" &&
          resource.data.get("studentUid", "") != "" &&
          exists(/databases/$(database)/documents/users/$(resource.data.studentUid)) &&
          get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.get("coordinatorUid", "") == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.get("departmentId", "") == coordinatorDepartment() &&
          get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.get("studentRecordId", "") != "" &&
          exists(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)) &&
          get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)).data.get("coordinatorUid", "") == request.auth.uid &&
          get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)).data.get("departmentId", "") == coordinatorDepartment() &&
          get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)).data.get("studentUid", "") == resource.data.studentUid
        ) ||
        (hasRole("student") && resource.data.studentUid == request.auth.uid);

      allow create, update, delete: if isAdmin() || isStaff();
    }

    match /applications/{applicationId} {
      allow read: if isAdmin() || isCoordinator() || isStaff();
      allow create: if isAdmin() || isStaff();
      allow update: if isAdmin() || isCoordinator() || isStaff();
      allow delete: if isAdmin();
    }

    match /evaluations/{evaluationId} {
      allow read: if isAdmin() || isCoordinator() || isStaff();
      allow create, update: if isAdmin() || isCoordinator() || isStaff();
      allow delete: if isAdmin();
    }

    match /partnerCompanies/{companyId} {
      allow read: if isAdmin() || isCoordinator() || isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}