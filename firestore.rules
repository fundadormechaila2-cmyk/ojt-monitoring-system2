rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn() && profile().data.role == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isCoordinator() {
      return hasRole("coordinator");
    }

    function isStaff() {
      return hasRole("staff");
    }

    function departmentCode(value) {
      return !(value is string) ? "" :
        value.matches("(?i).*\\bbsba\\b.*") || value.matches("(?i).*business administration.*") ? "BSBA" :
        value.matches("(?i).*\\bbsit\\b.*") || value.matches("(?i).*information technology.*") ? "BSIT" :
        value.matches("(?i).*\\bbshm\\b.*") || value.matches("(?i).*hospitality management.*") ? "BSHM" :
        value.matches("(?i).*\\bbsed\\b.*") || value.matches("(?i).*secondary education.*") ? "BSED" :
        value.matches("(?i).*\\bbeed\\b.*") || value.matches("(?i).*elementary education.*") ? "BEED" : "";
    }

    function coordinatorDepartment() {
      let id = departmentCode(profile().data.get("departmentId", ""));
      return id != "" ? id : departmentCode(profile().data.get("department", ""));
    }

    match /users/{userId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() &&
        request.auth.uid == userId &&
        (isCoordinator() || hasRole("supervisor")) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["firstName", "lastName", "contactNumber", "updatedAt"]) &&
        request.resource.data.firstName is string &&
        request.resource.data.lastName is string &&
        request.resource.data.contactNumber is string &&
        request.resource.data.updatedAt == request.time
      );
    }

    match /students/{studentId} {
      allow read: if isAdmin() ||
        (isCoordinator() &&
          coordinatorDepartment() != "" &&
          resource.data.get("departmentId", "") == coordinatorDepartment() &&
          resource.data.get("coordinatorUid", "") == request.auth.uid) ||
        (hasRole("student") && request.auth.uid == studentId) ||
        (hasRole("student") && resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isStaff() ||
        (isCoordinator() &&
          coordinatorDepartment() != "" &&
          resource.data.get("studentUid", "") != "" &&
          exists(/databases/$(database)/documents/users/$(resource.data.studentUid)) &&
          get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.get("coordinatorUid", "") == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.get("departmentId", "") == coordinatorDepartment() &&
          get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.get("studentRecordId", "") != "" &&
          exists(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)) &&
          get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)).data.get("coordinatorUid", "") == request.auth.uid &&
          get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)).data.get("departmentId", "") == coordinatorDepartment() &&
          get(/databases/$(database)/documents/students/$(get(/databases/$(database)/documents/users/$(resource.data.studentUid)).data.studentRecordId)).data.get("studentUid", "") == resource.data.studentUid) ||
        (hasRole("student") && resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if isAdmin() || isStaff();
    }

    match /applications/{applicationId} {
      allow read: if isAdmin() || isCoordinator() || isStaff();
      allow create: if isAdmin() || isStaff();
      allow update: if isAdmin() || isCoordinator() || isStaff();
      allow delete: if isAdmin();
    }

    match /evaluations/{evaluationId} {
      allow read: if isAdmin() || isCoordinator() || isStaff();
      allow create, update: if isAdmin() || isCoordinator() || isStaff();
      allow delete: if isAdmin();
    }

    match /partnerCompanies/{companyId} {
      allow read: if isAdmin() || isCoordinator() || isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
