rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function hasRole(role) {
      return signedIn() && profile().data.role == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isCoordinator() {
      return hasRole("coordinator");
    }

    function isSupervisor() {
      return hasRole("supervisor");
    }

    function isStaff() {
      return hasRole("staff");
    }

    match /users/{userId} {
      allow read: if isAdmin() ||
        (isCoordinator() && resource.data.role == "supervisor") ||
        (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin() ||
        (isCoordinator() &&
          request.resource.data.role == "supervisor" &&
          request.resource.data.createdBy == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() || isCoordinator() || isSupervisor() || (signedIn() && request.auth.uid == studentId);
      allow create, update, delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() || isCoordinator() || isSupervisor() || isStaff() ||
        (signedIn() && resource.data.studentUid == request.auth.uid);
      allow create, update, delete: if isAdmin() || isCoordinator() || isStaff();
    }

    match /attendanceQrScans/{scanId} {
      allow read, write: if false;
    }

    match /studentLoginActivity/{activityId} {
      allow read: if isAdmin() || isCoordinator();
      allow create: if hasRole("student") &&
        request.resource.data.keys().hasOnly([
          "userId",
          "studentName",
          "studentId",
          "email",
          "loggedInAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId",
          "studentName",
          "studentId",
          "email",
          "loggedInAt"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.studentName is string &&
        request.resource.data.studentId is string &&
        request.resource.data.email is string &&
        request.resource.data.loggedInAt == request.time;
    }

    match /applications/{applicationId} {
      allow read: if isAdmin() || isCoordinator() || isSupervisor() || isStaff();
      allow create: if isAdmin() || isSupervisor() || isStaff();
      allow update: if isAdmin() || isCoordinator() || isSupervisor() || isStaff();
      allow delete: if isAdmin();
    }

    match /evaluations/{evaluationId} {
      allow read: if isAdmin() || isCoordinator() || isSupervisor() || isStaff();
      allow create, update: if isAdmin() || isCoordinator() || isSupervisor() || isStaff();
      allow delete: if isAdmin();
    }

    match /partnerCompanies/{companyId} {
      allow read: if isAdmin() || isCoordinator() || isSupervisor() || isStaff();
      allow create, update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
