rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function profile() {
      return get(userPath(request.auth.uid)).data;
    }

    function hasRole(role) {
      return hasProfile() && profile().role == role;
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isCoordinator() {
      return hasRole("coordinator");
    }

    function isSupervisor() {
      return hasRole("supervisor");
    }

    function isStudent() {
      return hasRole("student");
    }

    function coordinatorOwns(data) {
      return isCoordinator() &&
        "coordinatorUid" in data &&
        data.coordinatorUid == request.auth.uid;
    }

    function validSupervisorAssignment(data) {
      return !("supervisorUid" in data) ||
        data.supervisorUid == null ||
        (data.supervisorUid is string &&
          (!exists(userPath(data.supervisorUid)) ||
            get(userPath(data.supervisorUid)).data.role == "supervisor"));
    }

    function supervisorOwnsStudent(studentUid) {
      return isSupervisor() &&
        studentUid is string &&
        exists(userPath(studentUid)) &&
        get(userPath(studentUid)).data.role == "student" &&
        (get(userPath(studentUid)).data.supervisorUid == request.auth.uid ||
          ("studentRecordId" in get(userPath(studentUid)).data &&
            exists(/databases/$(database)/documents/students/$(get(userPath(studentUid)).data.studentRecordId)) &&
            get(/databases/$(database)/documents/students/$(get(userPath(studentUid)).data.studentRecordId)).data.supervisorUid == request.auth.uid)) &&
        get(userPath(studentUid)).data.coordinatorUid is string &&
        exists(userPath(get(userPath(studentUid)).data.coordinatorUid)) &&
        get(userPath(get(userPath(studentUid)).data.coordinatorUid)).data.role == "coordinator" &&
        profile().department == get(userPath(get(userPath(studentUid)).data.coordinatorUid)).data.department;
    }

    function isOwnStudent(studentUid) {
      return isStudent() && studentUid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isAdmin() ||
        (signedIn() && request.auth.uid == userId) ||
        (isCoordinator() && resource.data.role == "student" &&
          resource.data.coordinatorUid == request.auth.uid) ||
        (isCoordinator() && resource.data.role == "supervisor") ||
        (isSupervisor() && resource.data.role == "student" &&
          supervisorOwnsStudent(userId));
      allow create: if isAdmin() ||
        (isCoordinator() &&
          request.resource.data.role == "supervisor" &&
          (request.resource.data.createdBy == request.auth.uid ||
            !("createdBy" in request.resource.data)));
      allow update: if isAdmin() ||
        (coordinatorOwns(resource.data) &&
          resource.data.role == "student" &&
          request.resource.data.coordinatorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "supervisorUid", "supervisorName", "updatedAt"
          ]) && validSupervisorAssignment(request.resource.data)) ||
        (isCoordinator() &&
          resource.data.role == "supervisor" &&
          (resource.data.createdBy == request.auth.uid ||
            !("createdBy" in resource.data))) ||
        (signedIn() && request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "role", "department", "coordinatorUid", "supervisorUid",
            "studentRecordId", "studentId", "status", "createdBy",
            "createdAt", "mustChangePassword", "temporaryPassword"
          ]));
      allow delete: if isAdmin();
    }

    match /students/{studentId} {
      allow read: if isAdmin() ||
        coordinatorOwns(resource.data) ||
        (isSupervisor() &&
          resource.data.supervisorUid == request.auth.uid) ||
        (isStudent() && (resource.data.studentUid == request.auth.uid ||
          studentId == request.auth.uid)) ||
        (resource.data.studentUid is string &&
          supervisorOwnsStudent(resource.data.studentUid));
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (coordinatorOwns(resource.data) &&
          request.resource.data.coordinatorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "supervisorUid", "supervisorName", "partnerCompanyId", "company", "updatedAt"
          ]) &&
          validSupervisorAssignment(request.resource.data)) ||
        (isStudent() && (resource.data.studentUid == request.auth.uid ||
          studentId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "role", "coordinatorUid", "supervisorUid", "studentUid", "requiredHours", "status", "ojtStatus"
          ]));
    }

    match /attendance/{attendanceId} {
      allow read: if isAdmin() ||
        coordinatorOwns(resource.data) ||
        isOwnStudent(resource.data.studentUid) ||
        (isSupervisor() &&
          resource.data.supervisorId == request.auth.uid) ||
        (resource.data.studentUid is string &&
          supervisorOwnsStudent(resource.data.studentUid));
      allow create: if isAdmin() ||
        (isSupervisor() &&
          request.resource.data.supervisorId == request.auth.uid);
      allow update: if isAdmin() ||
        (isSupervisor() &&
          (resource.data.supervisorId == request.auth.uid ||
           request.resource.data.supervisorId == request.auth.uid));
      allow delete: if isAdmin();
    }

    match /attendanceQrScans/{scanId} {
      allow read, write: if false;
    }

    match /studentLoginActivity/{activityId} {
      allow read: if isAdmin() || coordinatorOwns(resource.data);
      allow create: if isStudent() &&
        request.resource.data.keys().hasOnly([
          "userId", "studentName", "studentId", "email",
          "coordinatorUid", "loggedInAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId", "studentName", "studentId", "email", "loggedInAt"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.studentName is string &&
        request.resource.data.studentId is string &&
        request.resource.data.email is string &&
        (!("coordinatorUid" in request.resource.data) ||
          request.resource.data.coordinatorUid == profile().coordinatorUid) &&
        request.resource.data.loggedInAt == request.time;
      allow update, delete: if isAdmin();
    }

    match /applications/{applicationId} {
      allow read: if isAdmin() || coordinatorOwns(resource.data) ||
        (resource.data.studentUid is string &&
          (isOwnStudent(resource.data.studentUid) ||
            supervisorOwnsStudent(resource.data.studentUid)));
      allow create: if isAdmin() ||
        (isCoordinator() && coordinatorOwns(request.resource.data)) ||
        (isSupervisor() && request.resource.data.studentUid is string &&
          supervisorOwnsStudent(request.resource.data.studentUid));
      allow update: if isAdmin() ||
        (isCoordinator() && coordinatorOwns(resource.data) &&
          coordinatorOwns(request.resource.data)) ||
        (isSupervisor() && resource.data.studentUid is string &&
          supervisorOwnsStudent(resource.data.studentUid) &&
          request.resource.data.studentUid == resource.data.studentUid);
      allow delete: if isAdmin();
    }

    match /evaluations/{evaluationId} {
      allow read: if isAdmin() || coordinatorOwns(resource.data) ||
        (resource.data.studentUid is string &&
          (isOwnStudent(resource.data.studentUid) ||
            supervisorOwnsStudent(resource.data.studentUid)));
      allow create: if isAdmin() ||
        (isCoordinator() && coordinatorOwns(request.resource.data)) ||
        (isSupervisor() && request.resource.data.studentUid is string &&
          supervisorOwnsStudent(request.resource.data.studentUid));
      allow update: if isAdmin() ||
        (isCoordinator() && coordinatorOwns(resource.data) &&
          coordinatorOwns(request.resource.data)) ||
        (isSupervisor() && resource.data.studentUid is string &&
          supervisorOwnsStudent(resource.data.studentUid) &&
          request.resource.data.studentUid == resource.data.studentUid);
      allow delete: if isAdmin();
    }

    match /partnerCompanies/{companyId} {
      allow read: if isAdmin() || isCoordinator() || isSupervisor();
      allow create, update: if isAdmin() || isCoordinator();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}