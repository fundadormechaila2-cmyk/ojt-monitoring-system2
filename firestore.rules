rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasProfile() {
      return signedIn() && exists(userPath(request.auth.uid));
    }

    function profile() {
      return get(userPath(request.auth.uid)).data;
    }

    function liveProfile(data) {
      return data.get("isActive", true) != false &&
        data.get("isArchived", false) != true &&
        !(data.get("status", "ACTIVE") in ["INACTIVE", "ARCHIVED", "inactive", "archived"]);
    }

    function isLive() {
      return hasProfile() && liveProfile(profile());
    }

    function hasRole(role) {
      return isLive() && profile().role == role;
    }

    function studentAccountLive(studentUid) {
      return !(studentUid is string) ||
        !exists(userPath(studentUid)) ||
        liveProfile(get(userPath(studentUid)).data);
    }

    function lifecycleKeys() {
      return [
        "isActive", "isArchived", "deletedAt", "deletedBy", "deactivatedAt",
        "deactivatedBy", "reactivatedAt", "reactivatedBy", "restoredAt",
        "restoredBy", "deletionPending", "accountDeleted", "deletedAccountSnapshot"
      ];
    }

    function isAdmin() {
      return hasRole("admin");
    }

    function isCoordinator() {
      return hasRole("coordinator");
    }

    function isSupervisor() {
      return hasRole("supervisor");
    }

    function isStudent() {
      return hasRole("student");
    }

    function coordinatorOwns(data) {
      return isCoordinator() &&
        "coordinatorUid" in data &&
        data.coordinatorUid == request.auth.uid;
    }

    function departmentKey(data) {
      return data.get("departmentId", data.get("department", null));
    }

    function validSupervisorAssignment(data) {
      return !("supervisorUid" in data) ||
        data.supervisorUid == null ||
        (data.supervisorUid is string &&
          (!exists(userPath(data.supervisorUid)) ||
            (get(userPath(data.supervisorUid)).data.role == "supervisor" &&
              (!isCoordinator() ||
                departmentKey(get(userPath(data.supervisorUid)).data) == departmentKey(profile())))));
    }

    function supervisorOwnsStudent(studentUid) {
      return isSupervisor() &&
        studentUid is string &&
        exists(userPath(studentUid)) &&
        get(userPath(studentUid)).data.role == "student" &&
        (get(userPath(studentUid)).data.supervisorUid == request.auth.uid ||
          ("studentRecordId" in get(userPath(studentUid)).data &&
            exists(/databases/$(database)/documents/students/$(get(userPath(studentUid)).data.studentRecordId)) &&
            get(/databases/$(database)/documents/students/$(get(userPath(studentUid)).data.studentRecordId)).data.supervisorUid == request.auth.uid)) &&
        get(userPath(studentUid)).data.coordinatorUid is string &&
        exists(userPath(get(userPath(studentUid)).data.coordinatorUid)) &&
        get(userPath(get(userPath(studentUid)).data.coordinatorUid)).data.role == "coordinator" &&
        departmentKey(profile()) == departmentKey(get(userPath(get(userPath(studentUid)).data.coordinatorUid)).data);
    }

    function coordinatorOwnsStudent(studentUid) {
      return isCoordinator() &&
        studentUid is string &&
        exists(userPath(studentUid)) &&
        get(userPath(studentUid)).data.role == "student" &&
        (get(userPath(studentUid)).data.get("coordinatorUid", null) == request.auth.uid ||
          ("studentRecordId" in get(userPath(studentUid)).data &&
            exists(/databases/$(database)/documents/students/$(get(userPath(studentUid)).data.studentRecordId)) &&
            get(/databases/$(database)/documents/students/$(get(userPath(studentUid)).data.studentRecordId)).data.coordinatorUid == request.auth.uid));
    }

    function coordinatorOwnsRosterRecord(recordId) {
      return isCoordinator() &&
        recordId is string &&
        exists(/databases/$(database)/documents/students/$(recordId)) &&
        get(/databases/$(database)/documents/students/$(recordId)).data.coordinatorUid == request.auth.uid;
    }

    function coordinatorOwnsSupervisorRecord(supervisorId) {
      return isCoordinator() &&
        exists(userPath(supervisorId)) &&
        get(userPath(supervisorId)).data.role == "supervisor" &&
        get(userPath(supervisorId)).data.department == profile().department;
    }

    function isOwnStudent(studentUid) {
      return isStudent() && studentUid == request.auth.uid;
    }

    function coordinatorOwnsJournal(studentUid) {
      return coordinatorOwnsStudent(studentUid);
    }

    match /users/{userId} {
      allow read: if isAdmin() ||
        (signedIn() && request.auth.uid == userId) ||
        (isCoordinator() && resource.data.role == "student" &&
          resource.data.coordinatorUid == request.auth.uid) ||
        (isCoordinator() && resource.data.role == "supervisor" &&
          resource.data.department == profile().department) ||
        (isSupervisor() && resource.data.role == "student" &&
          supervisorOwnsStudent(userId));
      allow create: if isAdmin() ||
        (isCoordinator() &&
          request.resource.data.role == "supervisor" &&
          request.resource.data.department == profile().department &&
          (request.resource.data.createdBy == request.auth.uid ||
            !("createdBy" in request.resource.data)));
      allow update: if (isAdmin() &&
          (request.auth.uid != userId ||
            !request.resource.data.diff(resource.data).affectedKeys().hasAny([
              "role", "status"
            ].concat(lifecycleKeys())))) ||
        (coordinatorOwns(resource.data) &&
          resource.data.role == "student" &&
          request.resource.data.coordinatorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "supervisorUid", "supervisorName", "supervisorSchoolYear", "updatedAt"
          ]) && validSupervisorAssignment(request.resource.data)) ||
        (isCoordinator() &&
          resource.data.role == "supervisor" &&
          resource.data.department == profile().department &&
          request.resource.data.role == "supervisor" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "firstName", "lastName", "phone", "position", "company",
            "partnerCompanyId", "schoolYear", "isArchived", "isActive",
            "status", "archivedAt", "archivedBy", "archivedSchoolYear",
            "restoredAt", "restoredBy", "updatedAt"
          ]) &&
          request.resource.data.department == resource.data.department &&
          request.resource.data.role == "supervisor" &&
          request.resource.data.get("isArchived", false) is bool &&
          request.resource.data.get("isActive", true) is bool) ||
        (isLive() && request.auth.uid == userId &&
          resource.data.get("mustChangePassword", false) == true &&
          request.resource.data.mustChangePassword == false &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "mustChangePassword", "updatedAt"
          ])) ||
        (isLive() && request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "role", "department", "departmentId", "major", "coordinatorUid", "supervisorUid",
            "studentRecordId", "studentId", "status", "createdBy",
            "createdAt", "mustChangePassword", "accountNotificationStatus",
            "accountNotificationUpdatedAt"
          ].concat(lifecycleKeys())));
      // Accounts are removed only by the manageAccount Cloud Function.
      allow delete: if false;
    }

    match /studentAccounts/{userId} {
      allow read: if isAdmin() ||
        isOwnStudent(userId) ||
        (isCoordinator() &&
          resource.data.role == "student" &&
          resource.data.coordinatorUid == request.auth.uid) ||
        coordinatorOwnsStudent(userId) ||
        supervisorOwnsStudent(userId);
      allow create: if isAdmin();
      allow update: if isAdmin() ||
        (coordinatorOwnsStudent(userId) &&
          resource.data.role == "student" &&
          request.resource.data.role == "student" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "supervisorUid", "supervisorName", "supervisorSchoolYear", "updatedAt"
          ])) ||
        (isOwnStudent(userId) &&
          request.resource.data.role == "student" &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "email", "phone", "contactNumber", "address",
            "mustChangePassword", "updatedAt"
          ]));
      allow delete: if false;
    }

    match /students/{studentId} {
      allow read: if isAdmin() ||
        coordinatorOwns(resource.data) ||
        (isSupervisor() &&
          resource.data.supervisorUid == request.auth.uid) ||
        (isStudent() && (resource.data.studentUid == request.auth.uid ||
          studentId == request.auth.uid)) ||
        (resource.data.studentUid is string &&
          supervisorOwnsStudent(resource.data.studentUid));
      allow create: if isAdmin();
      allow delete: if false;
      allow update: if isAdmin() ||
        (coordinatorOwns(resource.data) &&
          request.resource.data.coordinatorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "supervisorUid", "supervisorName", "supervisorSchoolYear",
            "partnerCompanyId", "company", "updatedAt"
          ]) &&
          validSupervisorAssignment(request.resource.data)) ||
        (isStudent() && (resource.data.studentUid == request.auth.uid ||
          studentId == request.auth.uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "role", "coordinatorUid", "supervisorUid", "studentUid", "requiredHours", "status", "ojtStatus",
            "department", "departmentId", "major", "course",
            "accountNotificationStatus", "accountNotificationUpdatedAt"
          ].concat(lifecycleKeys())));
    }

    match /journals/{journalId} {
      allow read: if isOwnStudent(resource.data.studentUid) ||
        coordinatorOwnsJournal(resource.data.studentUid);
      allow create: if isOwnStudent(request.resource.data.studentUid) &&
        request.resource.data.keys().hasOnly([
          "studentUid", "date", "taskPerformed", "skillsLearned",
          "problemsEncountered", "reflection", "reportTitle", "week",
          "weeklyAccomplishments", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "studentUid", "date", "taskPerformed", "skillsLearned",
          "problemsEncountered", "reflection", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.date is string &&
        request.resource.data.taskPerformed is string &&
        request.resource.data.skillsLearned is string &&
        request.resource.data.problemsEncountered is string &&
        request.resource.data.reflection is string &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        (!("reportTitle" in request.resource.data) ||
          request.resource.data.reportTitle is string) &&
        (!("week" in request.resource.data) ||
          request.resource.data.week is string) &&
        (!("weeklyAccomplishments" in request.resource.data) ||
          request.resource.data.weeklyAccomplishments is string);
      allow update: if isOwnStudent(resource.data.studentUid) &&
        request.resource.data.studentUid == resource.data.studentUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "date", "taskPerformed", "skillsLearned",
          "problemsEncountered", "reflection", "updatedAt"
        ]) &&
        request.resource.data.date is string &&
        request.resource.data.taskPerformed is string &&
        request.resource.data.skillsLearned is string &&
        request.resource.data.problemsEncountered is string &&
        request.resource.data.reflection is string &&
        request.resource.data.updatedAt == request.time;
      allow delete: if isOwnStudent(resource.data.studentUid);
    }

    match /attendance/{attendanceId} {
      allow read: if (resource == null && (isAdmin() || isSupervisor())) ||
        isAdmin() ||
        coordinatorOwns(resource.data) ||
        (resource.data.get("studentUid", null) is string &&
          coordinatorOwnsStudent(resource.data.get("studentUid", null))) ||
        isOwnStudent(resource.data.studentUid) ||
        (isSupervisor() &&
          resource.data.supervisorId == request.auth.uid) ||
        (resource.data.get("studentUid", null) is string &&
          supervisorOwnsStudent(resource.data.get("studentUid", null)));
      allow create: if isAdmin() ||
        (isSupervisor() &&
          request.resource.data.supervisorId == request.auth.uid &&
          studentAccountLive(request.resource.data.get("studentUid", null)));
      allow update: if isAdmin() ||
        (isSupervisor() &&
          resource.data.supervisorId == request.auth.uid &&
          request.resource.data.supervisorId == request.auth.uid &&
          request.resource.data.get("studentUid", null) == resource.data.get("studentUid", null) &&
          (resource.data.get("coordinatorUid", null) == null ||
           request.resource.data.get("coordinatorUid", null) == resource.data.get("coordinatorUid", null)) &&
          request.resource.data.date == resource.data.date &&
          studentAccountLive(resource.data.get("studentUid", null)));
      // Attendance is academic history and is never hard-deleted from clients.
      allow delete: if false;
    }

    match /attendanceQrScans/{scanId} {
      allow read, write: if false;
    }

    match /studentLoginActivity/{activityId} {
      allow read: if isAdmin() || coordinatorOwns(resource.data);
      allow create: if isStudent() &&
        request.resource.data.keys().hasOnly([
          "userId", "studentName", "studentId", "email",
          "coordinatorUid", "loggedInAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "userId", "studentName", "studentId", "email", "loggedInAt"
        ]) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.studentName is string &&
        request.resource.data.studentId is string &&
        request.resource.data.email is string &&
        (!("coordinatorUid" in request.resource.data) ||
          request.resource.data.coordinatorUid == profile().coordinatorUid) &&
        request.resource.data.loggedInAt == request.time;
      allow update: if isAdmin();
      allow delete: if false;
    }

    match /applications/{applicationId} {
      allow read: if isAdmin() || coordinatorOwns(resource.data) ||
        (resource.data.studentUid is string &&
          (isOwnStudent(resource.data.studentUid) ||
            supervisorOwnsStudent(resource.data.studentUid)));
      allow create: if isAdmin() ||
        (isCoordinator() && coordinatorOwns(request.resource.data)) ||
        (isSupervisor() && request.resource.data.studentUid is string &&
          supervisorOwnsStudent(request.resource.data.studentUid));
      allow update: if isAdmin() ||
        (isCoordinator() && coordinatorOwns(resource.data) &&
          coordinatorOwns(request.resource.data)) ||
        (isSupervisor() && resource.data.studentUid is string &&
          supervisorOwnsStudent(resource.data.studentUid) &&
          request.resource.data.studentUid == resource.data.studentUid);
      allow delete: if false;
    }

    match /evaluations/{evaluationId} {
      allow read: if isAdmin() || coordinatorOwns(resource.data) ||
        (resource.data.studentUid is string &&
          (isOwnStudent(resource.data.studentUid) ||
            supervisorOwnsStudent(resource.data.studentUid)));
      allow create: if isAdmin() ||
        (isCoordinator() && coordinatorOwns(request.resource.data)) ||
        (isSupervisor() && request.resource.data.studentUid is string &&
          supervisorOwnsStudent(request.resource.data.studentUid));
      allow update: if isAdmin() ||
        (isCoordinator() && coordinatorOwns(resource.data) &&
          coordinatorOwns(request.resource.data)) ||
        (isSupervisor() && resource.data.studentUid is string &&
          supervisorOwnsStudent(resource.data.studentUid) &&
          request.resource.data.studentUid == resource.data.studentUid);
      allow delete: if false;
    }

    match /partnerCompanies/{companyId} {
      allow read: if isAdmin() || isCoordinator() || isSupervisor();
      allow create, update: if isAdmin() || isCoordinator();
      allow delete: if isAdmin();
    }

    match /schoolYears/{schoolYearId} {
      allow read: if isAdmin() || isCoordinator();
      allow create: if isAdmin() &&
        request.resource.data.keys().hasOnly([
          "name", "active", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "name", "active", "createdAt", "updatedAt"
        ]) &&
        request.resource.data.name == schoolYearId &&
        request.resource.data.name.matches("^[0-9]{4}-[0-9]{4}$") &&
        request.resource.data.active == true &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "active", "updatedAt"
        ]) &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.active is bool &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /users/{supervisorId}/supervisorAssignmentHistory/{historyId} {
      allow read: if coordinatorOwnsSupervisorRecord(supervisorId);
      allow create: if coordinatorOwnsSupervisorRecord(supervisorId) &&
        request.resource.data.keys().hasOnly([
          "supervisorUid", "supervisorName", "studentRecordId", "studentId",
          "studentName", "schoolYear", "company", "coordinatorUid",
          "reason", "previousSupervisorUid", "previousSupervisorName",
          "recordedAt"
        ]) &&
        request.resource.data.keys().hasAll([
          "supervisorUid", "supervisorName", "studentRecordId", "studentId",
          "studentName", "schoolYear", "coordinatorUid", "reason", "recordedAt"
        ]) &&
        request.resource.data.supervisorUid == supervisorId &&
        request.resource.data.studentRecordId is string &&
        coordinatorOwnsRosterRecord(request.resource.data.studentRecordId) &&
        request.resource.data.coordinatorUid == request.auth.uid &&
        request.resource.data.reason in [
          "assigned", "reassigned", "unassigned", "school-year-archived"
        ] &&
        request.resource.data.recordedAt == request.time;
      allow update, delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}